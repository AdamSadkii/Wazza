{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: create venv",
      "type": "shell",
      "command": "python -m venv .venv",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": []
    },
    {
      "label": "backend: install deps",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/pip.exe install -r requirements.txt",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "dependsOn": ["backend: create venv"],
      "problemMatcher": []
    },
    {
      "label": "backend: run server",
      "type": "shell",
      "command": "${workspaceFolder}/backend/.venv/Scripts/python.exe server.py",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "firmware: build",
      "type": "shell",
      "command": "pio run",
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "firmware: upload",
      "type": "shell",
      "command": "pio run -t upload",
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "firmware: monitor",
      "type": "shell",
      "command": "pio device monitor",
      "options": {
        "cwd": "${workspaceFolder}/firmware"
      },
      "problemMatcher": []
    }
  ]
}
